# Non-secret configuration. Copy to .env and fill in.
# AWS credentials do NOT go here — they live in ~/.aws/credentials via `aws configure`.

AWS_PROFILE=gxp-val
AWS_REGION=eu-west-1

# Set after step 4 (bucket name must be globally unique; we derive it from the account id)
GXP_BUCKET=
GXP_GLUE_DATABASE=gxp_val_db
GXP_ATHENA_WORKGROUP=gxp-val-wg
GXP_SNS_TOPIC=gxp-val-alerts

# Email that receives validation failure alerts (SNS free tier: 1000 emails/month)
GXP_ALERT_EMAIL=
